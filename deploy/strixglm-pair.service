[Unit]
Description=StrixHaloClusterGLM native paired OpenAI coordinator
After=haloclu-engine.service
PartOf=haloclu-engine.service

[Service]
Type=simple
WorkingDirectory=/home/funboy/StrixHaloClusterGLM
ExecStart=/home/funboy/StrixHaloClusterGLM/bin/strixglm cluster --config /home/funboy/StrixHaloClusterGLM/config.json serve-pair
KillMode=control-group
KillSignal=SIGTERM
TimeoutStopSec=45
Restart=no
UMask=0077
NoNewPrivileges=true
MemoryMax=2G
