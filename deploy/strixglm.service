[Unit]
Description=StrixHaloClusterGLM gateway, coding agent and frontend

[Service]
Type=simple
WorkingDirectory=/home/funboy/StrixHaloClusterGLM
ExecStart=/home/funboy/StrixHaloClusterGLM/bin/strixglm serve --config /home/funboy/StrixHaloClusterGLM/config.json
UMask=0077
Restart=no
TimeoutStopSec=1900

[Install]
WantedBy=default.target
